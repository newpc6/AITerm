[Unit]
Description=AITerm - AI Terminal Management Tool
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_USERNAME
WorkingDirectory=/path/to/aiterm
Environment="PATH=/path/to/conda/envs/aiterm/bin"
ExecStart=/path/to/conda/envs/aiterm/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aiterm

[Install]
WantedBy=multi-user.target
